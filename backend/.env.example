# ============================================================
#  GRAHITA DESIGN — Backend Environment Variables Template
# ============================================================
#  Salin file ini menjadi .env:
#    cp .env.example .env
#  JANGAN commit file .env ke git repository!
# ============================================================

# --- SUPERADMIN DEFAULT ACCOUNT ---
# Email dan password yang digunakan saat pertama kali server dijalankan.
# Ganti dengan email dan password admin yang aman.
SUPERADMIN_EMAIL=superadmin@grahita.id
SUPERADMIN_PASSWORD=grahita_admin_secure_pass_replace_this

# --- DEFAULT SUB-ADMIN ACCOUNT (Opsional) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# --- JWT SECRET ---
# Ganti dengan string random yang panjang dan unik di production!
JWT_SECRET=replace-with-a-long-random-secret-key-for-jwt-signing

# --- SMTP EMAIL (opsional) ---
# Jika diisi, OTP, reset password, dan contact inquiry dikirim via email.
# Jika kosong, email akan di-log ke terminal backend (mode development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@grahita.id
CONTACT_INQUIRY_RECEIVER=your_email@gmail.com

# --- SERVER ---
PORT=3000
NODE_ENV=development
